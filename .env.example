# Node environment: development | production | test
NODE_ENV=production

# Server port (internal, Nginx proxies to this)
PORT=3001

# PostgreSQL connection string. MUST include connection_limit=5 for 1GB RAM
DATABASE_URL=postgresql://nos:nos_password@postgres:5432/nos?schema=public&connection_limit=5

# PostgreSQL credentials for Docker init (used by compose)
POSTGRES_USER=nos
POSTGRES_PASSWORD=nos_password
POSTGRES_DB=nos

# JWT secrets (min 32 chars, generate with: openssl rand -base64 64)
JWT_SECRET=change_this_to_32_char_min_secret
JWT_EXPIRATION=15m
REFRESH_SECRET=change_this_to_32_char_min_refresh_secret

# Agent authentication secret
AGENT_TOKEN_SECRET=change_this_to_32_char_min_agent_secret

# Frontend URL for CORS
FRONTEND_URL=https://nos.is-a.dev

# Backend URL for agent
BACKEND_URL=https://nos.is-a.dev
