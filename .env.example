# ==============================================================================
# NOS (Network Operating System) Monorepo - Global Environment Example
# ==============================================================================
# This file serves as the documentation and fallback reference for global environment
# variables used in Docker Compose and developer tooling.
#
# NOTE: Each application in apps/* has its own dedicated .env.example with specific parameters.
# Copy this file to .env in the monorepo root for full-stack local Docker Compose deployment.
# ==============================================================================

# --- General Configuration ---
NODE_ENV=development
TZ=UTC

# --- PostgreSQL Configuration (for Prisma & Services) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nos_admin
POSTGRES_PASSWORD=secure_nos_password
POSTGRES_DB=nos_database
DATABASE_URL="postgresql://nos_admin:secure_nos_password@postgres:5432/nos_database?schema=public"
# Local developer override (when running apps outside container targeting docker port):
# DATABASE_URL="postgresql://nos_admin:secure_nos_password@localhost:5432/nos_database?schema=public"

# --- PgAdmin (Database Management Interface) ---
PGADMIN_DEFAULT_EMAIL=admin@nos.internal
PGADMIN_DEFAULT_PASSWORD=secure_pgadmin_password
PGADMIN_PORT=5050

# --- Redis (Prepared for Event Pub/Sub & Rate Limiting - Not Actively Integrated Yet) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password
REDIS_URL="redis://:secure_redis_password@redis:6379/0"

# --- Backend Service (NestJS + Fastify) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
API_PREFIX=api/v1

# --- Frontend Service (Next.js 16) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Monitoring Agent (.NET Worker Service) ---
AGENT_POLL_INTERVAL_MS=5000
AGENT_NODE_ID=node_placeholder_001
