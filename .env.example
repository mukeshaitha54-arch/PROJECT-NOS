# ============================================
# NOS Production Environment Template
# Copy this file to .env and fill in real values
# DO NOT commit .env to GitHub
# ============================================

NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://13.127.187.47

# Database
POSTGRES_USER=nos_admin
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=nos_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=5

# Cache
REDIS_URL=redis://redis:6379

# Security Secrets — Generate ALL of these with: openssl rand -hex 32
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
REFRESH_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
REFRESH_TOKEN_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
AGENT_TOKEN_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
AGENT_API_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://13.127.187.47:3001/api/v1

# Email / SMTP Configuration
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="NOS PLATFORM <your-email@gmail.com>"

# Email verification enforcement
REQUIRE_EMAIL_VERIFICATION=true
