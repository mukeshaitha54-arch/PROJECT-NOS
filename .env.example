# Server & Environment
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost

# Database
POSTGRES_USER=nos_admin
POSTGRES_PASSWORD=[REDACTED — GENERATE STRONG RANDOM VALUE]
POSTGRES_DB=nos_database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=5

# Cache
REDIS_URL=redis://:[REDACTED — GENERATE STRONG RANDOM VALUE]@redis:6379/0

# Security Secrets
JWT_SECRET=[REDACTED — GENERATE STRONG RANDOM VALUE]
REFRESH_SECRET=[REDACTED — GENERATE STRONG RANDOM VALUE]
REFRESH_TOKEN_SECRET=[REDACTED — GENERATE STRONG RANDOM VALUE]
AGENT_TOKEN_SECRET=[REDACTED — GENERATE STRONG RANDOM VALUE]
AGENT_API_KEY=[REDACTED — GENERATE STRONG RANDOM VALUE]
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Email / SMTP Configuration
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your-gmail@gmail.com

# Email verification (true = block login until OTP verified)
REQUIRE_EMAIL_VERIFICATION=true
