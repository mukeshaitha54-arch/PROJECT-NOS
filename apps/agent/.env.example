# ==============================================================================
# NOS .NET Monitoring Agent Environmental Variables Template
# ==============================================================================
# Copy this file to .env during standalone worker service execution.
# ==============================================================================

# General environment definition
DOTNET_ENVIRONMENT=Development

# Agent node parameters
AgentConfig__NodeId=nos-agent-local-node-001
AgentConfig__PollIntervalSeconds=5
AgentConfig__ApiIngestionEndpoint=http://localhost:4000/api/v1
