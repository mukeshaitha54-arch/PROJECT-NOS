// =============================================================================
// PHASE 7: DEVICE OPERATIONAL TIMELINE
// Permanent immutable event log for every lifecycle event on a device.
// Invaluable for incident forensics, SLA reporting, and operator review.
// =============================================================================

enum TimelineEventType {
  REGISTERED
  HEARTBEAT
  ONLINE
  OFFLINE
  INVENTORY_UPDATED
  INVENTORY_DIFF
  ALERT_TRIGGERED
  ALERT_ACKNOWLEDGED
  ALERT_ESCALATED
  ALERT_RESOLVED
  ALERT_SUPPRESSED
  MAINTENANCE_START
  MAINTENANCE_END
  AGENT_UPDATE
  CONFIG_CHANGE
  OPERATOR_NOTE
  SECURITY_EVENT
  SYSTEM_EVENT
}

enum TimelineSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model DeviceTimelineEvent {
  id          String            @id @default(uuid())
  deviceId    String
  device      Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventType   TimelineEventType
  severity    TimelineSeverity  @default(INFO)
  title       String
  detail      String?
  actorId     String?
  actorName   String?
  relatedId   String?
  relatedType String?
  metadata    Json?
  timestamp   DateTime          @default(now())

  @@index([deviceId, timestamp(sort: Desc)])
  @@index([deviceId, eventType])
  @@index([deviceId, severity])
  @@map("device_timeline_events")
}

// ==========================================
// PHASE 8: ENTERPRISE FLEET COLLABORATION
// ==========================================

model RegistrationKey {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName        String
  keyHash            String       @unique // SHA256(key)
  keyPrefix          String // E.g., NOS-ABCD
  status             String       @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  maxUses            Int          @default(0) // 0 means unlimited
  currentUses        Int          @default(0)
  expiresAt          DateTime?
  allowedDepartments String[]
  allowedTeams       String[]
  allowedGroups      String[]
  allowedTags        String[]
  createdBy          String
  createdAt          DateTime     @default(now())
  lastUsed           DateTime?
  lastUsedBy         String?
  lastUsedIp         String?
  revokedBy          String?
  revokedReason      String?
  notes              String?

  // Analytics fields (tracked per key)
  totalGenerated Int @default(1)
  failedAttempts Int @default(0)
  devicesCreated Int @default(0)

  @@index([organizationId])
  @@index([status])
  @@map("registration_keys")
}

// ==========================================
// MODULE 3: RETENTION AGGREGATION & FLEET JOBS
// ==========================================

model TelemetryAggregation {
  id             String   @id @default(uuid())
  deviceId       String
  tenantId       String?  @default("default-org")
  tier           String   // 1m | 15m | 1h | 1d
  granularity    String   @default("1m") // "1m", "15m", "1h", "1d"
  avgCpu         Float    @default(0.0)
  maxCpu         Float    @default(0.0)
  minCpu         Float    @default(0.0)
  avgRam         Float    @default(0.0)
  maxRam         Float    @default(0.0)
  avgDisk        Float    @default(0.0)
  avgNetwork     Float    @default(0.0)
  sampleCount    Int      @default(1)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  @@index([deviceId, tier, periodStart(sort: Desc)])
  @@index([deviceId, granularity, periodStart(sort: Desc)])
  @@map("telemetry_aggregations")
}

model BulkJob {
  id                String   @id @default(uuid())
  jobId             String   @unique
  organizationId    String?
  action            String   // TAG, ASSIGN_GROUP, UPDATE_POLICY, REBOOT, RUN_SCRIPT
  status            String   @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED
  accepted          Boolean  @default(true)
  queued            Boolean  @default(true)
  estimatedDevices  Int      @default(0)
  processedCount    Int      @default(0)
  failedCount       Int      @default(0)
  details           String?  // JSON formatted details or errors
  performedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([jobId])
  @@index([organizationId])
  @@map("bulk_jobs")
}

model KeyValue {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  @@map("key_values")
}


