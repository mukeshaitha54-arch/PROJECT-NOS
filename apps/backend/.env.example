# ==============================================================================
# NOS Backend Environmental Variables Template
# ==============================================================================
# Copy this file to .env during local backend server development.
# ==============================================================================

# Application environment and binding
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=api/v1

# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://nos_admin:secure_nos_password@localhost:5432/nos_database?schema=public"

# Prepared Redis Configuration (Infrastructure ready, active application integration postponed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password
REDIS_URL="redis://:secure_redis_password@localhost:6379/0"
